# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Required for AI features (import + resume checker) ---
ANTHROPIC_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dollarresume

# --- Auth (if using Supabase for auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Billing (optional — leave BILLING_ENABLED=false for a free self-hosted instance) ---
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- App ---
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=change-me-to-a-long-random-string
